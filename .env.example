# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# Google AI Studio (free tier)
GEMINI_API_KEY=

# Nebius Token Factory (OpenAI-compatible, base URL https://api.tokenfactory.nebius.com/v1)
NEBIUS_API_KEY=

# Qdrant Cloud (deployed app uses these; local dev uses Docker)
QDRANT_URL=
QDRANT_API_KEY=

# Langfuse tracing (optional — app works without these)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Hugging Face (for deployment)
HF_TOKEN=
